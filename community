function CreateListingDialog({ open, onOpenChange, onCreated }: { open: boolean; onOpenChange: (v: boolean) => void; onCreated: (li: ListingItem) => void }) { const [title, setTitle] = useState(""); const [price, setPrice] = useState(0); const [currency, setCurrency] = useState("₦"); const [category, setCategory] = useState(""); const [description, setDescription] = useState(""); const [images, setImages] = useState<File[]>([]); const [submitting, setSubmitting] = useState(false);
async function create() { setSubmitting(true); try { const uploaded: string[] = []; for (const f of images) { const u = await apiClient.uploadMedia(f); uploaded.push(u.url); } const li = await apiClient.createListing({ title, price, currency, category, description, images: uploaded }); onCreated(li); onOpenChange(false); setTitle(""); setPrice(0); setCurrency("₦"); setCategory(""); setDescription(""); setImages([]); } catch (e) { console.error(e); alert("Failed to create listing."); } finally { setSubmitting(false); } }
return ( <Dialog open={open} onOpenChange={onOpenChange}> <DialogContent className="sm:max-w-[425px] rounded-2xl"> <DialogHeader> <DialogTitle>New Listing</DialogTitle> <DialogDescription> Sell or offer something to the community </DialogDescription> </DialogHeader> <div className="grid gap-4 py-4"> <Input value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Title" className="rounded-2xl focus-visible:ring-offset-0" /> <Input type="number" value={price} onChange={(e) => setPrice(Number(e.target.value))} placeholder="Price" className="rounded-2xl focus-visible:ring-offset-0" /> <Input value={currency} onChange={(e) => setCurrency(e.target.value)} placeholder="Currency" className="rounded-2xl focus-visible:ring-offset-0" /> <Input value={category} onChange={(e) => setCategory(e.target.value)} placeholder="Category (e.g., Furniture, Electronics)" className="rounded-2xl focus-visible:ring-offset-0" /> <Textarea value={description} onChange={(e) => setDescription(e.target.value)} placeholder="Description" className="rounded-2xl focus-visible:ring-offset-0 min-h-[100px]" /> <div> <label htmlFor="listing-images" className="flex items-center gap-2 text-sm font-medium text-slate-700 cursor-pointer"> <ImageIcon className="h-5 w-5" /> Add images </label> <input id="listing-images" type="file" className="hidden" accept="image/*" multiple onChange={(e) => setImages(Array.from(e.target.files || []))} /> </div> {images.map((f, i) => ( <Badge key={i} variant="secondary" className="rounded-2xl gap-1"> {f.name} <button onClick={() => setImages(images.filter((_, j) => i !== j))} className="ml-1 text-xs">x</button> </Badge> ))} </div> <Button onClick={create} disabled={submitting} className="rounded-2xl gap-2"> {submitting ? <Loader2 className="mr-2 h-4 w-4 animate-spin" /> : null} Publish </Button> <p className="text-xs text-slate-500">Disclaimer: Guava App is not responsible for transactions made through the marketplace. Exercise caution and use discretion.</p> </DialogContent> </Dialog> ); }
